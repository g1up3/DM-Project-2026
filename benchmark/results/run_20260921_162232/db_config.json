    "enable_indexscan": "on"
  },
  "neo4j": {
    "server.memory.heap.initial_size": "512.00MiB",
    "server.memory.heap.max_size": "1.00GiB",
    "server.memory.pagecache.size": "512.00MiB",
    "db.tx_log.rotation.retention_policy": "2 days 2G"
  }
}